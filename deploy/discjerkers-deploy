#!/bin/sh
# Pulls main and rebuilds the container. Installed on the droplet as
# /usr/local/bin/discjerkers-deploy and run by the GitHub Action through a
# forced command in root's authorized_keys (see README "Auto-deploy").
#
# Only tracked files change: .env and data/ are gitignored, so orders,
# accounts, photos, matches and the change log are never touched.
# nginx is not touched either; that stays a by-hand change on the server.
set -eu

APP=/var/www/discjerkers
BRANCH=main
HEALTH=http://127.0.0.1:3040/healthz

exec 9>/var/lock/discjerkers-deploy.lock
flock -n 9 || { echo "another deploy is running"; exit 1; }

cd "$APP"
git fetch --quiet origin "$BRANCH"
git reset --hard "origin/$BRANCH"
echo "deploying $(git log -1 --format='%h %s')"

docker compose up -d --build --remove-orphans
docker image prune -f >/dev/null

# Wait for the new container to answer.
i=0
while [ "$i" -lt 30 ]; do
  if curl -fsS "$HEALTH" >/dev/null 2>&1; then
    echo "healthy: $(curl -fsS "$HEALTH")"
    exit 0
  fi
  i=$((i + 1))
  sleep 2
done

echo "not healthy after 60s; last logs:"
docker compose logs --tail 60 discjerkers
exit 1
