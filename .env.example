# ---- Site ----
PORT=3030
SITE_URL=http://localhost:3030
SITE_NAME=Disc Jerkers

# ---- Printify ----
# Personal Access Token: Printify dashboard > My Profile > Connections > Personal Access Tokens
# Scopes needed: shops.read, products.read, orders.read, orders.write
PRINTIFY_API_TOKEN=
# Numeric shop id. Leave blank and the server picks the first shop on the account
# (it logs the id on boot so you can pin it here).
PRINTIFY_SHOP_ID=
# Submit paid orders straight to production instead of leaving them on-hold for review.
# Keep this false until you've watched a few real orders come through.
PRINTIFY_AUTO_PRODUCTION=false

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
# Countries checkout will ship to (comma separated ISO codes). All of them see the
# same quoted flat rate, so keep this US-only unless the rate covers the spread.
SHIP_COUNTRIES=US
# Fallback flat shipping in cents, used only if Printify's quote call fails
FALLBACK_SHIPPING_CENTS=595
# Let Stripe Tax calculate sales tax (requires Stripe Tax to be enabled on the account)
STRIPE_AUTOMATIC_TAX=false
